<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- App-private files exposed to external viewers via FileProvider. -->
    <files-path name="documents" path="documents/" />
    <!-- Downloaded APK handed to the system package installer by the in-app updater. -->
    <cache-path name="updates" path="updates/" />
    <!-- Exported local diagnostic zip bundles shared by the user for bug reports. -->
    <cache-path name="diag" path="diag/" />
    <!-- Exported hardware profile files (.navbeam) shared via FileProvider. -->
    <cache-path name="shared_profiles" path="shared_profiles/" />
</paths>
